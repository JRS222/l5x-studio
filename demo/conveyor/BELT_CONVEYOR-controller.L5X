    <Programs>
      <Program Name="BELT_CONVEYOR" MainRoutineName="Main" Type="Normal" Disabled="false" UseAsFolder="false">
        <Tags>
          <Tag  Name="SCAN_IN_SEEN" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="TRACK_INIT_DONE" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="TRACK_MOVE_ZONE" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="TRACK_NDX" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="TRACK_SENS_PREV" TagType="Base" DataType="BOOL" Dimensions="18" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
        </Tags>
        <Routines>,          <Routine Name="Main" Type="RLL">,            <Description><![CDATA[Main scan generated by L5X Studio: INIT_CONFIG, TRACK_INIT, one JSR per belt drive, TRACK_MOVE, TRACK_SCAN, TRACK_CLEAR.]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[INITIALISE CONFIGURATION (ENET offsets)]]></Comment>,                <Text><![CDATA[JSR(INIT_CONFIG,0);]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Comment><![CDATA[TRAY TRACKING INIT (first scan clears TRACK_TBL)]]></Comment>,                <Text><![CDATA[JSR(TRACK_INIT,0);]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Comment><![CDATA[BELT DRIVE BELT1 | belt conveyor; straight]]></Comment>,                <Text><![CDATA[JSR(BELT_BELT1_DRIVE,0);]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Comment><![CDATA[BELT DRIVE SPIRAL_UP | belt conveyor; SPIRAL up direction, pitch 0.9 m, height 2.7 m, slope 5.84 deg, 3 turns, radius R=1.4 m]]></Comment>,                <Text><![CDATA[JSR(BELT_SPIRAL_UP_DRIVE,0);]]></Text>,              </Rung>,              <Rung Number="4" Type="N">,                <Comment><![CDATA[BELT DRIVE BELT2 | belt conveyor; straight; joint turn 30 deg (rounded edge)]]></Comment>,                <Text><![CDATA[JSR(BELT_BELT2_DRIVE,0);]]></Text>,              </Rung>,              <Rung Number="5" Type="N">,                <Comment><![CDATA[TRAY TRACKING MOVE (zone sensor falling edges)]]></Comment>,                <Text><![CDATA[JSR(TRACK_MOVE,0);]]></Text>,              </Rung>,              <Rung Number="6" Type="N">,                <Comment><![CDATA[TRAY TRACKING SCAN (barcode reads)]]></Comment>,                <Text><![CDATA[JSR(TRACK_SCAN,0);]]></Text>,              </Rung>,              <Rung Number="7" Type="N">,                <Comment><![CDATA[TRAY TRACKING CLEAR (TRACK_RESET)]]></Comment>,                <Text><![CDATA[JSR(TRACK_CLEAR,0);]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="INIT_CONFIG" Type="RLL">,            <Description><![CDATA[Runtime configuration generated by L5X Studio (belt mode): CONFIG_ZPA.ENET_OFFSET = 1, CONFIG_ZPA.FIRST_ADDR = 1 used by the group I/O mapping routines.]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[ENET CONFIG: first ENET word and device-status node]]></Comment>,                <Text><![CDATA[MOV(1,CONFIG_ZPA.ENET_OFFSET);MOV(1,CONFIG_ZPA.FIRST_ADDR);]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="BELT_BELT1_DRIVE" Type="RLL">,            <Description><![CDATA[Belt conveyor drive control for BELT1 (belt conveyor; straight). RUN_CMD latch with DRIVE_FAULT and SAFETY_OK interlocks; drive status word BELT1_DRIVE_STATUS is written by the drive interface.]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[START/STOP LATCH: BELT1 RUN_CMD latches DRIVE_RUN; fault or SAFETY_OK drops it]]></Comment>,                <Text><![CDATA[[XIC(BELT1_RUN_CMD)XIO(BELT1_DRIVE_FAULT)XIC(SAFETY_OK)]OTL(BELT1_DRIVE_RUN);]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Comment><![CDATA[STOP/FAULT INTERLOCK: clears the drive latch]]></Comment>,                <Text><![CDATA[[XIO(BELT1_RUN_CMD) ,XIC(BELT1_DRIVE_FAULT) ,XIO(SAFETY_OK)]OTU(BELT1_DRIVE_RUN);]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Comment><![CDATA[DRIVE RUN CONTACTOR on spare 1799ER group output bit (ZPA01:O.Data.3)]]></Comment>,                <Text><![CDATA[[XIC(BELT1_DRIVE_RUN)]OTE(ZPA01:O.Data.3);]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Comment><![CDATA[DRIVE READY/FAULT contact on spare 1799ER group input bit (ZPA01:I.Data.3)]]></Comment>,                <Text><![CDATA[[XIC(ZPA01:I.Data.3)]OTE(BELT1_DRIVE_FAULT);]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="BELT_SPIRAL_UP_DRIVE" Type="RLL">,            <Description><![CDATA[Belt conveyor drive control for SPIRAL_UP (belt conveyor; SPIRAL up direction, pitch 0.9 m, height 2.7 m, slope 5.84 deg, 3 turns, radius R=1.4 m). RUN_CMD latch with DRIVE_FAULT and SAFETY_OK interlocks; drive status word SPIRAL_UP_DRIVE_STATUS is written by the drive interface.]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[START/STOP LATCH: SPIRAL_UP RUN_CMD latches DRIVE_RUN; fault or SAFETY_OK drops it]]></Comment>,                <Text><![CDATA[[XIC(SPIRAL_UP_RUN_CMD)XIO(SPIRAL_UP_DRIVE_FAULT)XIC(SAFETY_OK)]OTL(SPIRAL_UP_DRIVE_RUN);]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Comment><![CDATA[STOP/FAULT INTERLOCK: clears the drive latch]]></Comment>,                <Text><![CDATA[[XIO(SPIRAL_UP_RUN_CMD) ,XIC(SPIRAL_UP_DRIVE_FAULT) ,XIO(SAFETY_OK)]OTU(SPIRAL_UP_DRIVE_RUN);]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Comment><![CDATA[DRIVE RUN CONTACTOR on spare 1799ER group output bit (ZPA03:O.Data.5)]]></Comment>,                <Text><![CDATA[[XIC(SPIRAL_UP_DRIVE_RUN)]OTE(ZPA03:O.Data.5);]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Comment><![CDATA[DRIVE READY/FAULT contact on spare 1799ER group input bit (ZPA03:I.Data.5)]]></Comment>,                <Text><![CDATA[[XIC(ZPA03:I.Data.5)]OTE(SPIRAL_UP_DRIVE_FAULT);]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="BELT_BELT2_DRIVE" Type="RLL">,            <Description><![CDATA[Belt conveyor drive control for BELT2 (belt conveyor; straight; join