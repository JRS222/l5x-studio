      <Program Name="IO_MASTER_MAPPER" MainRoutineName="MAIN" Type="Normal" Disabled="false" UseAsFolder="false">
        <Tags>
          <Tag Name="ZPA_CURR_NODE" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag Name="ZPA_IO_TMP" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
        </Tags>
        <Routines>,          <Routine Name="MAIN" Type="RLL">,            <Description><![CDATA[IO_MASTER_MAPPER main generated by L5X Studio: read the ZPA group block words into ENET_INPUTS, then write ENET_OUTPUTS to the blocks.]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[READ ZPA GROUP INPUT WORDS]]></Comment>,                <Text><![CDATA[JSR(IO_ENET_INPUTS,0);]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Comment><![CDATA[WRITE ZPA GROUP OUTPUT WORDS]]></Comment>,                <Text><![CDATA[JSR(IO_ENET_OUTPUTS,0);]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="IO_ENET_INPUTS" Type="RLL">,            <Description><![CDATA[I/O mapping generated by L5X Studio: copy each ZPAxx 1799ER group input word into ENET_INPUTS (and read the module fault code via GSV), then each transfer device block word into XFERnn_INPUTS + a following ENET_INPUTS word. 4 zone group block(s) + 0 device block(s) = 4 ENET words.]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[SETUP ZPA_IO_TMP]]></Comment>,                <Text><![CDATA[[SUB(CONFIG_ZPA.ENET_OFFSET,1,ZPA_IO_TMP) ,SUB(CONFIG_ZPA.FIRST_ADDR,1,ZPA_CURR_NODE) ];]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Comment><![CDATA[ZPA #1 INPUTS (group block ZPA01)]]></Comment>,                <Text><![CDATA[[ADD(ZPA_IO_TMP,1,ZPA_IO_TMP) ,ADD(ZPA_CURR_NODE,1,ZPA_CURR_NODE) ,MOV(ZPA01:I.Data,ENET_INPUTS[ZPA_IO_TMP]) ,GSV(Module,ZPA01,FaultCode,ENET_DEVICE_STATUS[ZPA_CURR_NODE]) ];]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Comment><![CDATA[ZPA #2 INPUTS (group block ZPA02)]]></Comment>,                <Text><![CDATA[[ADD(ZPA_IO_TMP,1,ZPA_IO_TMP) ,ADD(ZPA_CURR_NODE,1,ZPA_CURR_NODE) ,MOV(ZPA02:I.Data,ENET_INPUTS[ZPA_IO_TMP]) ,GSV(Module,ZPA02,FaultCode,ENET_DEVICE_STATUS[ZPA_CURR_NODE]) ];]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Comment><![CDATA[ZPA #3 INPUTS (group block ZPA03)]]></Comment>,                <Text><![CDATA[[ADD(ZPA_IO_TMP,1,ZPA_IO_TMP) ,ADD(ZPA_CURR_NODE,1,ZPA_CURR_NODE) ,MOV(ZPA03:I.Data,ENET_INPUTS[ZPA_IO_TMP]) ,GSV(Module,ZPA03,FaultCode,ENET_DEVICE_STATUS[ZPA_CURR_NODE]) ];]]></Text>,              </Rung>,              <Rung Number="4" Type="N">,                <Comment><![CDATA[ZPA #4 INPUTS (group block ZPA04)]]></Comment>,                <Text><![CDATA[[ADD(ZPA_IO_TMP,1,ZPA_IO_TMP) ,ADD(ZPA_CURR_NODE,1,ZPA_CURR_NODE) ,MOV(ZPA04:I.Data,ENET_INPUTS[ZPA_IO_TMP]) ,GSV(Module,ZPA04,FaultCode,ENET_DEVICE_STATUS[ZPA_CURR_NODE]) ];]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="IO_ENET_OUTPUTS" Type="RLL">,            <Description><![CDATA[I/O mapping generated by L5X Studio: copy ENET_OUTPUTS words to each ZPAxx 1799ER group output word, and each XFERnn_OUTPUTS DINT to its device block output word (ENET word appended after the zone groups). 4 ENET words.]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[SETUP ZPA_IO_TMP]]></Comment>,                <Text><![CDATA[SUB(CONFIG_ZPA.ENET_OFFSET,1,ZPA_IO_TMP);]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Comment><![CDATA[ZPA #1 OUTPUTS (group block ZPA01)]]></Comment>,                <Text><![CDATA[[ADD(ZPA_IO_TMP,1,ZPA_IO_TMP) ,MOV(ENET_OUTPUTS[ZPA_IO_TMP],ZPA01:O.Data) ];]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Comment><![CDATA[ZPA #2 OUTPUTS (group block ZPA02)]]></Comment>,                <Text><![CDATA[[ADD(ZPA_IO_TMP,1,ZPA_IO_TMP) ,MOV(ENET_OUTPUTS[ZPA_IO_TMP],ZPA02:O.Data) ];]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Comment><![CDATA[ZPA #3 OUTPUTS (group block ZPA03)]]></Comment>,                <Text><![CDATA[[ADD(ZPA_IO_TMP,1,ZPA_IO_TMP) ,MOV(ENET_OUTPUTS[ZPA_IO_TMP],ZPA03:O.Data) ];]]></Text>,              </Rung>,              <Rung Number="4" Type="N">,                <Comment><![CDATA[ZPA #4 OUTPUTS (group block ZPA04)]]></Comment>,                <Text><![CDATA[[ADD(ZPA_IO_TMP,1,ZPA_IO_TMP) ,MOV(ENET_OUTPUTS[ZPA_IO_TMP],ZPA04:O.Data) ];]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,        </Routines>
      </Program>
