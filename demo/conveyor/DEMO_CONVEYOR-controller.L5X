        <Routines>,          <Routine Name="MAIN" Type="RLL">,            <Description><![CDATA[IO_MASTER_MAPPER main generated by L5X Studio: read the ZPA group block words into ENET_INPUTS, then write ENET_OUTPUTS to the blocks.]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[READ ZPA GROUP INPUT WORDS]]></Comment>,                <Text><![CDATA[JSR(IO_ENET_INPUTS,0);]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Comment><![CDATA[WRITE ZPA GROUP OUTPUT WORDS]]></Comment>,                <Text><![CDATA[JSR(IO_ENET_OUTPUTS,0);]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="IO_ENET_INPUTS" Type="RLL">,            <Description><![CDATA[I/O mapping generated by L5X Studio: copy each ZPAxx 1799ER group input word into ENET_INPUTS (and read the module fault code via GSV), then each transfer device block word into XFERnn_INPUTS + a following ENET_INPUTS word. 7 zone group block(s) + 3 device block(s) = 10 ENET words.]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[SETUP ZPA_IO_TMP]]></Comment>,                <Text><![CDATA[[SUB(CONFIG_ZPA.ENET_OFFSET,1,ZPA_IO_TMP) ,SUB(CONFIG_ZPA.FIRST_ADDR,1,ZPA_CURR_NODE) ];]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Comment><![CDATA[ZPA #1 INPUTS (group block ZPA01)]]></Comment>,                <Text><![CDATA[[ADD(ZPA_IO_TMP,1,ZPA_IO_TMP) ,ADD(ZPA_CURR_NODE,1,ZPA_CURR_NODE) ,MOV(ZPA01:I.Data,ENET_INPUTS[ZPA_IO_TMP]) ,GSV(Module,ZPA01,FaultCode,ENET_DEVICE_STATUS[ZPA_CURR_NODE]) ];]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Comment><![CDATA[ZPA #2 INPUTS (group block ZPA02)]]></Comment>,                <Text><![CDATA[[ADD(ZPA_IO_TMP,1,ZPA_IO_TMP) ,ADD(ZPA_CURR_NODE,1,ZPA_CURR_NODE) ,MOV(ZPA02:I.Data,ENET_INPU