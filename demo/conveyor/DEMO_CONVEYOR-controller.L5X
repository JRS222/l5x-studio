    <Programs>
      <Program Name="DEMO_CONVEYOR" MainRoutineName="Main" Type="Normal" Disabled="false" UseAsFolder="false">
        <Tags>
          <Tag Name="DUMMY" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag Name="DUMMY2" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag Name="MAP_OFFSET_INT" TagType="Base" DataType="INT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[The INT OFFSETto look at in the PCIDS card when getting and putting data into the PCIDS]]></Description></Tag>
          <Tag  Name="MERGE_MERGE1_LAST_MAIN" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="MERGE_MERGE1_MAIN_REQ" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="MERGE_MERGE1_MAIN_TMR" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="MERGE_MERGE1_OCC" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="MERGE_MERGE1_SPUR_REQ" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="MERGE_MERGE1_SPUR_TMR" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write"/>
