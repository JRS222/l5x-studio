          <Tag Name="NDX_NET" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag Name="NDX_ZONE" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag Name="NDX_ZONE_IO" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag Name="NDX_ZPA" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag Name="POS_ADD" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Variable used for mapping OFFSETS when setting and getting data out of the PCIDS card]]></Description></Tag>
          <Tag Name="POS_START" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Variable used for mapping OFFSETS when setting and getting data out of the PCIDS card]]></Description></Tag>
          <Tag  Name="SCAN1_SEEN" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag Name="SRTR_NDX" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag Name="SRTR_ZPA_BEFORE_SRTR" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag Name="SRTR_ZPA_BEFORE_SRTR_NET" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag Name="STOP_JOG_ONE_SHOT" TagType="Base" DataType="BOOL" Dimensions="64" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[One Shot used to stop jogging the Induction when it is taken on of MAINT]]></Description></Tag>
          <Tag Name="THE_ZONE" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="TRACK_INIT_DONE" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="TRACK_MOVE_ZONE" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="TRACK_NDX" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="TRACK_SENS_PREV" TagType="Base" DataType="BOOL" Dimensions="34" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="XFER01_EXTEND_TMR" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="XFER01_RETRACT_TMR" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="XFER01_STATE" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="XFER02_DIFF" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="XFER02_DIR" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="XFER02_ROTATE_TMR" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="XFER02_STATE" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="XFER03_DIR" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="XFER03_LOWER_TMR" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="XFER03_RAISE_TMR" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="XFER03_STATE" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
          <Tag  Name="XFER03_XFER_TMR" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write"/>
          <Tag Name="ZPA_NDX" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[The current ZPA that we are analizing in the FOR loop]]></Description></Tag>
        </Tags>
        <Routines>,          <Routine Name="Main" Type="RLL">,            <Description><![CDATA[Main scan generated by L5X Studio: INIT_CONFIG, TRACK_INIT, ZPA_MAPPING loop, one JSR per ZPA group scan, one JSR per merge junction, one JSR per transfer device, TRACK_MOVE, TRACK_SCAN, TRACK_CLEAR.]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[INITIALISE CONFIGURATION (ENET offsets, ZPA group count, per-group NUM_OF_ZONES/SENSOR_IO)]]></Comment>,                <Text><![CDATA[JSR(INIT_CONFIG,0);]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Comment><![CDATA[TRAY TRACKING INIT (first scan clears TRACK_TBL)]]></Comment>,                <Text><![CDATA[JSR(TRACK_INIT,0);]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Comment><![CDATA[MAP ENET I/O WORDS <-> NETS[1].ZPA GROUPS (ZPA_MAPPING loop over NUM_OF_ZPA_NODES)]]></Comment>,                <Text><![CDATA[[SUB(CONFIG_ZPA.ENET_OFFSET,1,MAP_OFFSET_INT) ,FOR(ZPA_MAPPING,ZPA_NDX,1,NETS[1].NUM_OF_ZPA_NODES,1) ];]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Comment><![CDATA[SEG1 group 1: 4 zone(s) -> ZPA1_4ZONE_SCAN_ZONE | roller conveyor; straight]]></Comment>,                <Text><![CDATA[JSR(ZPA_G1_4ZONE_SCAN,0);]]></Text>,              </Rung>,              <Rung Number="4" Type="N">,                <Comment><![CDATA[SEG2 group 2: 2 zone(s) -> ZPA1_2ZONE_SCAN_ZONE | roller conveyor; CURVE radius R=1.748 m, sweep 90 deg; tapered rollers TS-20 (delta 20 mm, cone half-angle 0.955 deg); taper standard TS-20]]></Comment>,                <Text><![CDATA[JSR(ZPA_G2_2ZONE_SCAN,0);]]></Text>,              </Rung>,              <Rung Number="5" Type="N">,                <Comment><![CDATA[SEG3 group 3: 3 zone(s) -> ZPA1_3ZONE_SCAN_ZONE | roller conveyor; straight]]></Comment>,                <Text><![CDATA[JSR(ZPA_G3_3ZONE_SCAN,0);]]></Text>,              </Rung>,              <Rung Number="6" Type="N">,                <Comment><![CDATA[SPIRAL1 group 4: 8 zone(s) -> ZPA1_8ZONE_SCAN_ZONE | roller conveyor; SPIRAL up direction, pitch 0.8 m, height 2.4 m, slope 6.06 deg, 3 turns, radius R=1.2 m; taper standard TS-26]]></Comment>,                <Text><![CDATA[JSR(ZPA_G4_8ZONE_SCAN,0);]]></Text>,              </Rung>,              <Rung Number="7" Type="N">,                <Comment><![CDATA[SPIRAL1 group 5: 8 zone(s) -> ZPA1_8ZONE_SCAN_ZONE | roller conveyor; SPIRAL up direction, pitch 0.8 m, height 2.4 m, slope 6.06 deg, 3 turns, radius R=1.2 m; taper standard TS-26]]></Comment>,                <Text><![CDATA[JSR(ZPA_G5_8ZONE_SCAN,0);]]></Text>,              </Rung>,              <Rung Number="8" Type="N">,                <Comment><![CDATA[SPIRAL1 group 6: 7 zone(s) -> ZPA1_7ZONE_SCAN_ZONE | roller conveyor; SPIRAL up direction, pitch 0.8 m, height 2.4 m, slope 6.06 deg, 3 turns, radius R=1.2 m; taper standard TS-26]]></Comment>,                <Text><![CDATA[JSR(ZPA_G6_7ZONE_SCAN,0);]]></Text>,              </Rung>,              <Rung Number="9" Type="N">,                <Comment><![CDATA[SPUR1 group 7: 2 zone(s) -> ZPA1_2ZONE_SCAN_ZONE | roller conveyor; straight]]></Comment>,                <Text><![CDATA[JSR(ZPA_G7_2ZONE_SCAN,0);]]></Text>,              </Rung>,              <Rung Number="10" Type="N">,                <Comment><![CDATA[MERGE MERGE1 (priority alternate): main zone 4, merge zone 5, spur zone 34]]></Comment>,                <Text><![CDATA[JSR(MERGE_MERGE1,0);]]></Text>,              </Rung>,              <Rung Number="11" Type="N">,                <Comment><![CDATA[Pusher / divert PUSHER1 (block XFER01) - one-way divert]]></Comment>,                <Text><![CDATA[JSR(PUSHER_PUSHER1,0);]]></Text>,              </Rung>,              <Rung Number="12" Type="N">,                <Comment><![CDATA[Rotary table ROTARY1 (block XFER02) - bidirectional]]></Comment>,                <Text><![CDATA[JSR(ROTARY_ROTARY1,0);]]></Text>,              </Rung>,              <Rung Number="13" Type="N">,                <Comment><![CDATA[Cross-belt pop-up transfer POPUP1 (block XFER03) - bidirectional]]></Comment>,                <Text><![CDATA[JSR(POPUP_POPUP1,0);]]></Text>,              </Rung>,              <Rung Number="14" Type="N">,                <Comment><![CDATA[TRAY TRACKING MOVE (zone sensor falling edges)]]></Comment>,                <Text><![CDATA[JSR(TRACK_MOVE,0);]]></Text>,              </Rung>,              <Rung Number="15" Type="N">,                <Comment><![CDATA[TRAY TRACKING SCAN (barcode reads)]]></Comment>,                <Text><![CDATA[JSR(TRACK_SCAN,0);]]></Text>,              </Rung>,              <Rung Number="16" Type="N">,                <Comment><![CDATA[TRAY TRACKING CLEAR (TRACK_RESET)]]></Comment>,                <Text><![CDATA[JSR(TRACK_CLEAR,0);]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="INIT_CONFIG" Type="RLL">,            <Description><![CDATA[Runtime configuration generated by L5X Studio: NETS[1].NUM_OF_ZPA_NODES = 7, CONFIG_ZPA.ENET_OFFSET = 1, CONFIG_ZPA.FIRST_ADDR = 1, all zones' NETS[1].ZPA[g].INPUTS.8 = 1 (normal release permission; merge routines override the two upstream zones), per-group NUM_OF_ZONES and SENSOR_IO and 8 s merge blocked-release timer presets. The CONFIG_ZPA UDT revision used by the templates has no NUM_OF_ZONES/SENSOR_IO members; those live on the per-group ZPA_CONFIG structure and are set there.]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[NETWORK / ENET CONFIG: group count + first ENET word and device-status node + merge 8 s timeout presets]]></Comment>,                <Text><![CDATA[MOV(7,NETS[1].NUM_OF_ZPA_NODES);MOV(1,CONFIG_ZPA.ENET_OFFSET);MOV(1,CONFIG_ZPA.FIRST_ADDR);MOV(8000,MERGE_MERGE1_MAIN_TMR.PRE);MOV(8000,MERGE_MERGE1_SPUR_TMR.PRE);]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Comment><![CDATA[ZPA GROUP 1 (SEG1, block ZPA01): release permission INPUTS.8 = 1, NUM_OF_ZONES / SENSOR_IO]]></Comment>,                <Text><![CDATA[MOV(1,NETS[1].ZPA[1].INPUTS.8);MOV(4,NETS[1].ZPA[1].CONFIG.NUM_OF_ZONES);MOV(0,NETS[1].ZPA[1].CONFIG.SENSOR_IO[1]);MOV(1,NETS[1].ZPA[1].CONFIG.SENSOR_IO[2]);MOV(2,NETS[1].ZPA[1].CONFIG.SENSOR_IO[3]);MOV(3,NETS[1].ZPA[1].CONFIG.SENSOR_IO[4]);]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Comment><![CDATA[ZPA GROUP 2 (SEG2, block ZPA02): release permission INPUTS.8 = 1, NUM_OF_ZONES / SENSOR_IO]]></Comment>,                <Text><![CDATA[MOV(1,NETS[1].ZPA[2].INPUTS.8);MOV(2,NETS[1].ZPA[2].CONFIG.NUM_OF_ZONES);MOV(0,NETS[1].ZPA[2].CONFIG.SENSOR_IO[1]);MOV(1,NETS[1].ZPA[2].CONFIG.SENSOR_IO[2]);]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Comment><![CDATA[ZPA GROUP 3 (SEG3, block ZPA03): release permission INPUTS.8 = 1, NUM_OF_ZONES / SENSOR_IO]]></Comment>,                <Text><![CDATA[MOV(1,NETS[1].ZPA[3].INPUTS.8);MOV(3,NETS[1].ZPA[3].CONFIG.NUM_OF_ZONES);MOV(0,NETS[1].ZPA[3].CONFIG.SENSOR_IO[1]);MOV(1,NETS[1].ZPA[3].CONFIG.SENSOR_IO[2]);MOV(2,NETS[1].ZPA[3].CONFIG.SENSOR_IO[3]);]]></Text>,              </Rung>,              <Rung Number="4" Type="N">,                <Comment><![CDATA[ZPA GROUP 4 (SPIRAL1, block ZPA04): release permission INPUTS.8 = 1, NUM_OF_ZONES / SENSOR_IO]]></Comment>,                <Text><![CDATA[MOV(1,NETS[1].ZPA[4].INPUTS.8);MOV(8,NETS[1].ZPA[4].CONFIG.NUM_OF_ZONES);MOV(0,NETS[1].ZPA[4].CONFIG.SENSOR_IO[1]);MOV(1,NETS[1].ZPA[4].CONFIG.SENSOR_IO[2]);MOV(2,NETS[1].ZPA[4].CONFIG.SENSOR_IO[3]);MOV(3,NETS[1].ZPA[4].CONFIG.SENSOR_IO[4]);MOV(4,NETS[1].ZPA[4].CONFIG.SENSOR_IO[5]);MOV(5,NETS[1].ZPA[4].CONFIG.SENSOR_IO[6]);MOV(6,NETS[1].ZPA[4].CONFIG.SENSOR_IO[7]);MOV(7,NETS[1].ZPA[4].CONFIG.SENSOR_IO[8]);]]></Text>,              </Rung>,              <Rung Number="5" Type="N">,                <Comment><![CDATA[ZPA GROUP 5 (SPIRAL1, block ZPA05): release permission INPUTS.8 = 1, NUM_OF_ZONES / SENSOR_IO]]></Comment>,                <Text><![CDATA[MOV(1,NETS[1].ZPA[5].INPUTS.8);MOV(8,NETS[1].ZPA[5].CONFIG.NUM_OF_ZONES);MOV(0,NETS[1].ZPA[5].CONFIG.SENSOR_IO[1]);MOV(1,NETS[1].ZPA[5].CONFIG.SENSOR_IO[2]);MOV(2,NETS[1].ZPA[5].CONFIG.SENSOR_IO[3]);MOV(3,NETS[1].ZPA[5].CONFIG.SENSOR_IO[4]);MOV(4,NETS[1].ZPA[5].CONFIG.SENSOR_IO[5]);MOV(5,NETS[1].ZPA[5].CONFIG.SENSOR_IO[6]);MOV(6,NETS[1].ZPA[5].CONFIG.SENSOR_IO[7]);MOV(7,NETS[1].ZPA[5].CONFIG.SENSOR_IO[8]);]]></Text>,              </Rung>,              <Rung Number="6" Type="N">,                <Comment><![CDATA[ZPA GROUP 6 (SPIRAL1, block ZPA06): release permission INPUTS.8 = 1, NUM_OF_ZONES / SENSOR_IO]]></Comment>,                <Text><![CDATA[MOV(1,NETS[1].ZPA[6].INPUTS.8);MOV(7,NETS[1].ZPA[6].CONFIG.NUM_OF_ZONES);MOV(0,NETS[1].ZPA[6].CONFIG.SENSOR_IO[1]);MOV(1,NETS[1].ZPA[6].CONFIG.SENSOR_IO[2]);MOV(2,NETS[1].ZPA[6].CONFIG.SENSOR_IO[3]);MOV(3,NETS[1].ZPA[6].CONFIG.SENSOR_IO[4]);MOV(4,NETS[1].ZPA[6].CONFIG.SENSOR_IO[5]);MOV(5,NETS[1].ZPA[6].CONFIG.SENSOR_IO[6]);MOV(6,NETS[1].ZPA[6].CONFIG.SENSOR_IO[7]);]]></Text>,              </Rung>,              <Rung Number="7" Type="N">,                <Comment><![CDATA[ZPA GROUP 7 (SPUR1, block ZPA07): release permission INPUTS.8 = 1, NUM_OF_ZONES / SENSOR_IO]]></Comment>,                <Text><![CDATA[MOV(1,NETS[1].ZPA[7].INPUTS.8);MOV(2,NETS[1].ZPA[7].CONFIG.NUM_OF_ZONES);MOV(0,NETS[1].ZPA[7].CONFIG.SENSOR_IO[1]);MOV(1,NETS[1].ZPA[7].CONFIG.SENSOR_IO[2]);]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="ZPA_G1_4ZONE_SCAN" Type="RLL">,            <Description><![CDATA[ZPA 1 LOGIC
