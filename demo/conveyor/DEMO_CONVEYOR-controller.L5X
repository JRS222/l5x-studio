<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="32.03" TargetName="CONVEYOR_PLC" TargetType="Controller" ContainsContext="false">
  <Controller Use="Target" Name="CONVEYOR_PLC" ProcessorType="1756-L83E" MajorRev="32" MinorRev="14">
    <DataTypes>
      <DataType Name="CONFIG_SORTER" Family="NoFamily" Class="User"><Members><Member Name="ENET_OFFSET_CURVE_SENSOR" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The OFFSET of the SORTER curve middle sensor (MUST BE A ZERO IF IT IS NOT PRESENT)]]></Description></Member><Member Name="ENET_OFFSET_CURVE_SENSOR_BIT" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The BIT that the sensor is located within the DNET Offset]]></Description></Member><Member Name="ENET_OFFSET_ENCODER_PANEL" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The OFFSET of the ENCODER PROX for each sorter]]></Description></Member><Member Name="ENET_OFFSET_ENCODER_PANEL_BIT" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The BIT that the ENCODER PROX can be found for each sorter (Usually in 721 panel at BIT 4)]]></Description></Member><Member Name="ENET_OFFSET_ENTRANCE_EYE" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The DNET OFFSET that the ENTRANCE EYE for this sorter can be found (Usually in ZPA 10/10 card at BIT 7)]]></Description></Member><Member Name="ENET_OFFSET_ENTRANCE_EYE_BIT" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The BIT that this ENTRANCE eye is wired to. (Usually in ZPA 10/10 card at BIT 7)]]></Description></Member><Member Name="ENET_OFFSET_EXIT_EYE" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The DNET OFFSET that the EXIT EYE for this sorter can be found (Look for a 713 or 712, at BIT 7)]]></Description></Member><Member Name="ENET_OFFSET_EXIT_EYE_BIT" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The BIT that this EXIT eye is wired to. (Look for a 713 or 712, at BIT 7)]]></Description></Member><Member Name="ENET_OFFSET_TUB_DETECT" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The OFFSET that the TUB DETECT Sensor for this sorter can be found]]></Description></Member><Member Name="ENET_OFFSET_VFD" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The OFFSET that the SORTER VFD for this sorter can be found]]></Description></Member><Member Name="ENET_OFFSET_NON_VFD_START" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[DNET byte offset to start sorter belt on NON-VFD systems]]></Description></Member><Member Name="ENET_OFFSET_NON_VFD_START_BIT" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[DNET bit offset to start sorter belt on NON-VFD systems]]></Description></Member><Member Name="ENET_OFFSET_NON_VFD_RUNNING" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[DNET byte offset to see if the sorter motor is running]]></Description></Member><Member Name="ENET_OFFSET_NON_VFD_RUNNING_BIT" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[DNET bit offset to see if the sorter motor is running]]></Description></Member><Member Name="ENET_OFFSET_NON_VFD_FAULTED" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[DNET byte offset to see if sorter motor is faulted]]></Description></Member><Member Name="ENET_OFFSET_NON_VFD_FAULTED_BIT" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[DNET bit offset to see if sorter motor is faulted]]></Description></Member><Member Name="CURVE_FEEDS_IND_AREA" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Set to a 1 if this a sorter that is a curve and the sorter ahead is the induction area]]></Description></Member><Member Name="HAS_A_SCAN_AREA" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[BIT IS ON if this Sorter has a SCAN AREA (Scanners are present)]]></Description></Member><Member Name="HAS_A_VFD" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The Sorter has a VFD]]></Description></Member><Member Name="ZZZZZZZZZZCONFIG_SOR19" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/><Member Name="HAS_A_WHEEL_ENCODER" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZCONFIG_SOR19" BitNumber="0" ExternalAccess="Read/Write"><Description><![CDATA[Turn this on if your sortere is using a wheel encoder instead of a prox setup]]></Description></Member><Member Name="IS_A_HDS_SORTER" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZCONFIG_SOR19" BitNumber="1" ExternalAccess="Read/Write"><Description><![CDATA[Turn this BIT on when the sorter is a High Density Sorter]]></Description></Member><Member Name="PULSE_SPACING_BETWEEN_PKGS" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[How many pulses to search for data when inducting from the sorter (Use 12 when a side loader is close to a sorter induct)]]></Description></Member><Member Name="SCAN_ZONE_IS_ONE_BACK" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Set this bit if the scanners/cameras are mounted 3 zones away from the sorter instead of 2]]></Description></Member><Member Name="SORTER_DATA_ARRAY_MAX" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[This is the size of the SORTER_DATA.PUSH array, standard is 1499]]></Description></Member><Member Name="ZPA_TRACK_DATA_THRU" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[BIT IS ON if this Sorter has to track thru some ZPA to reach this sorter]]></Description></Member><Member Name="ZPA_AFTER_SRTR_NUM" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The ZPA number that needs to track data around]]></Description></Member><Member Name="ZPA_AFTER_SRTR_ZONES" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The ZPA number of ZONES that needs to track data around]]></Description></Member><Member Name="ZPA_AFTER_SRTR_NET" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The DNET network that this ZPA is on]]></Description></Member><Member Name="ZPA_BEFORE_SRTR_NUM" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The ZPA number that feeds each SORTER (Index 1 is sorter 1, index 2 is sorter 2...)]]></Description></Member><Member Name="ZPA_BEFORE_SRTR_ZONES" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The number of zones that feed each SORTER (Index 1 is sorter 1, index 2 is sorter 2...)]]></Description></Member><Member Name="ZPA_BEFORE_SRTR_NET" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The DNET network that this ZPA is on]]></Description></Member><Member Name="ZPA_STOPS_SRTR_NUM" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The ZPA Number that should stop the SORTER]]></Description></Member><Member Name="ZPA_STOPS_SRTR_ZONE" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The ZPA Zone that stops the sorter]]></Description></Member><Member Name="ZPA_STOPS_SRTR_NET" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The NETWORK that the ZPA is on that stops the sorter]]></Description></Member><Member Name="ZZZZZZZZZZCONFIG_SOR35" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/><Member Name="SENSOR_IS_RETRO" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZCONFIG_SOR35" BitNumber="0" ExternalAccess="Read/Write"><Description><![CDATA[BIT IS ON if the Sorter Sensors are Retro-reflective]]></Description></Member><Member Name="VFD_CMD_CLEAR_FAULT" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[2 = Legacy   3 = PowerFlex]]></Description></Member><Member Name="VFD_CMD_RUN" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[0 = Legacy   1 = PowerFlex]]></Description></Member><Member Name="VFD_CMD_STOP" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[7 = Legacy    0 = PowerFlex]]></Description></Member><Member Name="VFD_STATUS_FAULT" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[0 = Legacy     7 = PowerFlex]]></Description></Member><Member Name="VFD_STATUS_RUNNING" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[2 = Legacy     1 = PowerFlex]]></Description></Member><Member Name="ZZZZZZZZZZCONFIG_SOR42" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/><Member Name="USE_COP_INSTRUCTION" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZCONFIG_SOR42" BitNumber="0" ExternalAccess="Read/Write"><Description><![CDATA[Turn this on to make the sorter shift data use the CPS method]]></Description></Member><Member Name="USE_GROUPED_DATA_LOOP" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZCONFIG_SOR42" BitNumber="1" ExternalAccess="Read/Write"><Description><![CDATA[Turn this on to make the sorter shift data use a single loop to shift all the sorter data in a single FOR LOOP.  When the bit is off, each sorter runs its own FOR LOOP]]></Description></Member></Members></DataType>
      <DataType Name="CONFIG_ZPA" Family="NoFamily" Class="User"><Members><Member Name="ZZZZZZZZZZCONFIG_ZPA0" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/><Member Name="DNET_HAS_ZC_RUNNING_CODE" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZCONFIG_ZPA0" BitNumber="0" ExternalAccess="Read/Write"><Description><![CDATA[BIT IS ON if the ZPA is running ZC code on-board]]></Description></Member><Member Name="DNET_NUM_OF_NETWORKS" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The Number of DNET networks]]></Description></Member><Member Name="DNET_OFFSET" DataType="INT" Dimension="10" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The DNET OFFSET starting point for ZPA]]></Description></Member><Member Name="DNET_STARTING_NODE_NUM" DataType="INT" Dimension="10" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[THE FIRST NODE OF ZPA CONVEYOR FOR THIS DNET NETWORK]]></Description></Member><Member Name="ENET_OFFSET" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[The DNET OFFSET starting point for ZPA]]></Description></Member><Member Name="FIRST_ADDR" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[First IP Address of the ZPA]]></Description></Member><Member Name="ZZZZZZZZZZCONFIG_ZPA7" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/><Member Name="SORTER_SCAN_ZONE_RUNS_ZC_CODE" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZCONFIG_ZPA7" BitNumber="0" ExternalAccess="Read/Write"><Description><![CDATA[Turn this bit on if the ZPA conveyor feeding the sorter is on DNET and is running code on card]]></Description></Member><Member Name="ZPA_CODE_IS_RUNNING_ENET_FOR_LOOP" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZCONFIG_ZPA7" BitNumber="1" ExternalAccess="Read/Write"><Description><![CDATA[Turn this bit on if you are running all the ZPA using the FOR LOOP code]]></Description></Member><Member Name="ZPA_CODE_RUN_TURBO_MODE_LOW_LIMIT" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Turn this bit on if you are running all the ZPA using the FOR LOOP code and want TURBO MODE code enabled]]></Description></Member><Member Name="ZPA_CODE_RUN_TURBO_MODE_HIGH_LIMIT" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Turn this bit on if you are running all the ZPA using the FOR LOOP code and want TURBO MODE code enabled]]></Description></Member></Members></DataType>
      <DataType Name="GFX" Family="NoFamily" Class="User"><Members><Member Name="CMD_DIV_PUSHER_CYCLE" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Request to Cycle Diverter from GFX]]></Description></Member><Member Name="CMD_GR_CONV_JOG" DataType="BOOL" Dimension="128" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Request to jog GR Conveyor]]></Description></Member><Member Name="CMD_GR_OFS" DataType="BOOL" Dimension="128" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[BIT IS ON when the PUSHER is out of service]]></Description></Member><Member Name="CMD_GR_PUSHER_CYCLE" DataType="BOOL" Dimension="128" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Request to Cycle Pusher from GFX]]></Description></Member><Member Name="CMD_GR_PUSHER_EXTEND" DataType="BOOL" Dimension="128" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Request to Extend the Pusher from GFX]]></Description></Member><Member Name="CMD_GR_PUSHER_RETRACT" DataType="BOOL" Dimension="128" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Request to Retract the Pusher from GFX]]></Description></Member><Member Name="CMD_IND_JOG" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Request to JOG the Induction from GFX]]></Description></Member><Member Name="CMD_IND_MODE" DataType="INT" Dimension="10" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Current Mode of the Induction Area (1 = AUTO or 2 = SEMI-AUTO or 3 = MANUAL or 4 = MSWYB)]]></Description></Member><Member Name="CMD_LBA_JOG" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Request to JOG the LBA from GFX]]></Description></Member><Member Name="ZZZZZZZZZZGFX9" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/><Member Name="CMD_SORTER_AUTO_TUNE" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX9" BitNumber="0" ExternalAccess="Read/Write"><Description><![CDATA[Request to AUTO-TUNE from GFX]]></Description></Member><Member Name="CMD_SORTER_CLEAR" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX9" BitNumber="1" ExternalAccess="Read/Write"><Description><![CDATA[Request to CLEAR last ERROR from GFX]]></Description></Member><Member Name="CMD_SORTER_JOG" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Request to JOG the Sorter from GFX]]></Description></Member><Member Name="ZZZZZZZZZZGFX13" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/><Member Name="CMD_SORTER_MODE" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX13" BitNumber="0" ExternalAccess="Read/Write"><Description><![CDATA[BIT IS ON if it is in MAINT Mode]]></Description></Member><Member Name="CMD_SORTER_OFF" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX13" BitNumber="1" ExternalAccess="Read/Write"><Description><![CDATA[Request to turn the System OFF from GFX]]></Description></Member><Member Name="CMD_SORTER_ON" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX13" BitNumber="2" ExternalAccess="Read/Write"><Description><![CDATA[Request to turn the System ON from GFX]]></Description></Member><Member Name="CMD_SORTER_START" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX13" BitNumber="3" ExternalAccess="Read/Write"><Description><![CDATA[Request to START the Sorter from GFX]]></Description></Member><Member Name="CMD_SORTER_STOP" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX13" BitNumber="4" ExternalAccess="Read/Write"><Description><![CDATA[Request to STOP the Sorter from GFX]]></Description></Member><Member Name="CMD_SORTER_STOPONFULL_OFF" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX13" BitNumber="5" ExternalAccess="Read/Write"><Description><![CDATA[Request to turn OFF STOP_ON_FULL from GFX]]></Description></Member><Member Name="CMD_SORTER_STOPONFULL_ON" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX13" BitNumber="6" ExternalAccess="Read/Write"><Description><![CDATA[Request to turn ON STOP_ON_FULL from GFX]]></Description></Member><Member Name="IND_IVS_ERROR" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - IVS Sensor has a JAM]]></Description></Member><Member Name="IND_LVS_ERROR" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - LVS Sensor has a JAM]]></Description></Member><Member Name="IND_VFD_FAULT" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - Induction has a VFD Fault]]></Description></Member><Member Name="IND_HOURS" DataType="DINT" Dimension="10" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - Number of Hours the Induction Has Ran]]></Description></Member><Member Name="IND_STATUS" DataType="INT" Dimension="10" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - Induction Status (0 = Normal, 1 = Full,  2 = Jammed, 3 = Running)]]></Description></Member><Member Name="LAST_DAY_THRUPUT" DataType="DINT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[How many items inducted for the previous DAY]]></Description></Member><Member Name="LAST_HOUR_THRUPUT" DataType="DINT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[How many items inducted for the previous HOUR]]></Description></Member><Member Name="LAST_MINUTE_THRUPUT" DataType="DINT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[How many items inducted for the previous MINUTE]]></Description></Member><Member Name="LBA_HOURS" DataType="DINT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - Number of Hours the LBA Has Ran]]></Description></Member><Member Name="LBA_STATUS" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - LBA Status (0 = Normal, 1 = Full,  2 = Jammed, 3 = Running)]]></Description></Member><Member Name="LBA_VFD_FAULT" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - LBA has a VFD Fault]]></Description></Member><Member Name="STATUS_DIVERTER_POSITION_ERROR" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - POSITION ERROR FOR DP]]></Description></Member><Member Name="STATUS_DIVERTER_TUB_DETECT_ERROR" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - TUB DETECT SENSOR ERROR FOR DP]]></Description></Member><Member Name="STATUS_DIV_IO_INPUTS" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[IO Status for DIVERTER INPUTS]]></Description></Member><Member Name="STATUS_DIV_IO_OUTPUTS" DataType="INT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[IO Status for DIVERTER OUTPUTS]]></Description></Member><Member Name="STATUS_DIV_DIVERTS" DataType="DINT" Dimension="30" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Number of Turn Table Diverts]]></Description></Member><Member Name="STATUS_DNET_NODE_ERROR_00_31" DataType="DINT" Dimension="3" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - Node 0-31 error bits]]></Description></Member><Member Name="STATUS_DNET_NODE_ERROR_32_63" DataType="DINT" Dimension="3" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - Node 32-63 error bits]]></Description></Member><Member Name="STATUS_ERR_BADREADS" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - Bad Reads Exceeded is TRUE]]></Description></Member><Member Name="STATUS_GR_CONV_RUNNING" DataType="BOOL" Dimension="128" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Motorized RUNOUT conveyor is RUNNING]]></Description></Member><Member Name="STATUS_GR_CONV_FAULT" DataType="BOOL" Dimension="128" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Motorized RUNOUT conveyor is FAULTED]]></Description></Member><Member Name="STATUS_GR_DIVERTS" DataType="DINT" Dimension="100" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Number of Diverts to this Discharge]]></Description></Member><Member Name="STATUS_GR_EXTENDED" DataType="BOOL" Dimension="128" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Signal to GFX that the pusher is Cycling (Extended)]]></Description></Member><Member Name="STATUS_GR_FULL_TIMER" DataType="TIMER" Dimension="0" Radix="NullType" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Timer to trigger GFX to Speak]]></Description></Member><Member Name="ZZZZZZZZZZGFX45" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/><Member Name="STATUS_GR_FULL_TIMER_TRUE" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX45" BitNumber="0" ExternalAccess="Read/Write"><Description><![CDATA[Bit used to trigger GFX to Speak]]></Description></Member><Member Name="STATUS_GR_IO_INPUTS" DataType="INT" Dimension="100" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[IO Status for pusher INPUTS]]></Description></Member><Member Name="STATUS_GR_IO_OUTPUTS" DataType="INT" Dimension="100" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[IO Status for pushers OUTPUTS]]></Description></Member><Member Name="ZZZZZZZZZZGFX49" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/><Member Name="STATUS_ERROR_STARSHIP_TIMEOUT" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX49" BitNumber="0" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - Starship Timeout max has been reached]]></Description></Member><Member Name="STATUS_ERROR_STARSHIP_TIMEOUT_ONS" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX49" BitNumber="1" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - Starship Timeout max has been reached]]></Description></Member><Member Name="STATUS_SORTER_AUTO_TUNE" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX49" BitNumber="2" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - Auto Tune is TRUE]]></Description></Member><Member Name="STATUS_SORTER_DISCONNECT" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZGFX49" BitNumber="3" ExternalAccess="Read/Write"/><Member Name="STATUS_SORTER_ENERGY" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[STATUS back to GFX - Sorter Energy is TRUE]]></Description></Member><Member Name="ZZZZZZZZZZGFX55" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAc