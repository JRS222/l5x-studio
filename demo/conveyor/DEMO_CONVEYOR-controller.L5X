umber="25" Type="N">,                <Comment><![CDATA[ZPA 1 ZONE 2 HOURS RUN CALCULATOR]]></Comment>,                <Text><![CDATA[GEQ(NETS[1].ZPA[7].ZONE_HOURS[2],2000000000)MOV(0,NETS[1].ZPA[7].ZONE_HOURS[2]);]]></Text>,              </Rung>,              <Rung Number="26" Type="N">,                <Comment><![CDATA[ZPA 1 ZONE 2 HOURS RUN CALCULATOR]]></Comment>,                <Text><![CDATA[XIC(NETS[1].ZPA[7].OUTPUTS.1)RTO(NETS[1].ZPA[7].ZONE_HOURS_TIMER[2],?,?);]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="MERGE_MERGE1" Type="RLL">,            <Description><![CDATA[Merge junction MERGE1 generated by L5X Studio: priority=alternate; merge zone 5 (block ZPA02, entry sensor bit 0), main upstream zone 4 (block ZPA01), spur last zone 34 (block ZPA07), spur end segment SPUR1. Alternating/shortest release arbitration: sets the granted upstream zone's NETS[1].ZPA[g].INPUTS.8 = 1 and the other = 0 (templates consume it next scan). If a granted upstream zone stays blocked for 8 s the grant is swapped (jam/timeout handling).]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[MERGE MERGE1: priority=alternate, merge zone 5 (block ZPA02), main upstream zone 4 (block ZPA01), spur last zone 34 (block ZPA07); release grants on NETS[1].ZPA[g].INPUTS.8]]></Comment>,                <Text><![CDATA[XIC(NETS[1].ZPA[1].INPUTS.3)OTE(MERGE_MERGE1_MAIN_REQ);]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Comment><![CDATA[MERGE MERGE1: spur upstream zone requesting release?]]></Comment>,                <Text><![CDATA[XIC(NETS[1].ZPA[7].INPUTS.1)OTE(MERGE_MERGE1_SPUR_REQ);]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Comment><![CDATA[MERGE MERGE1: merge zone entry sensor (downstream occupied?)]]></Comment>,                <Text><![CDATA[XIC(NETS[1].ZPA[2].INPUTS.0)OTE(MERGE_MERGE1_OCC);]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Comment><![CDATA[MERGE MERGE1: GRANT MAIN - grant release to the main upstream zone (set its INPUTS.8 = 1, hold spur = 0)]]></Comment>,                <Text><![CDATA[XIO(MERGE_MERGE1_OCC)XIC(MERGE_MERGE1_MAIN_REQ)[XIO(MERGE_MERGE1_SPUR_REQ) ,XIO(MERGE_MERGE1_LAST_MAIN) ][OTL(MERGE_MERGE1_MAIN_GRANT) ,OTU(MERGE_MERGE1_SPUR_GRANT) ,MOV(0,NETS[1].ZPA[7].INPUTS.8) ,MOV(1,NETS[1].ZPA[1].INPUTS.8) ,OTL(MERGE_MERGE1_LAST_MAIN) ]]]></Text>,              </Rung>,              <Rung Number="4" Type="N">,                <Comment><![CDATA[MERGE MERGE1: GRANT SPUR - grant release to the spur last zone (set its INPUTS.8 = 1, hold main = 0)]]></Comment>,                <Text><![CDATA[XIO(MERGE_MERGE1_OCC)XIC(MERGE_MERGE1_SPUR_REQ)[XIO(MERGE_MERGE1_MAIN_REQ) ,XIC(MERGE_MERGE1_LAST_MAIN) ][OTU(MERGE_MERGE1_MAIN_GRANT) ,OTL(MERGE_MERGE1_SPUR_GRANT) ,MOV(0,NETS[1].ZPA[1].INPUTS.8) ,MOV(1,NETS[1].ZPA[7].INPUTS.8) ,OTU(MERGE_MERGE1_LAST_MAIN) ]]]></Text>,              </Rung>,              <Rung Number="5" Type="N">,                <Comment><![CDATA[MERGE MERGE1: merge zone occupied - hold BOTH upstream zones (INPUTS.8 = 0)]]></Comment>,                <Text><![CDATA[XIC(MERGE_MERGE1_OCC)[OTU(MERGE_MERGE1_MAIN_GRANT) ,OTU(MERGE_MERGE1_SPUR_GRANT) ,MOV(0,NETS[1].ZPA[1].INPUTS.8) ,MOV(0,NETS[1].ZPA[7].INPUTS.8) ]]]></Text>,              </Rung>,              <Rung Number="6" Type="N">,                <Comment><![CDATA[MERGE MERGE1: idle with no requests - restore both INPUTS.8 = 1 (normal running)]]></Comment>,                <Text><![CDATA[XIO(MERGE_MERGE1_OCC)XIO(MERGE_MERGE1_MAIN_REQ)XIO(MERGE_MERGE1_SPUR_REQ)XIO(MERGE_MERGE1_MAIN_GRANT)XIO(MERGE_MERGE1_SPUR_GRANT)MOV(1,NETS[1].ZPA[1].INPUTS.8)MOV(1,NETS[1].ZPA[7].INPUTS.8);]]></Text>,              </Rung>,              <Rung Number="7" Type="N">,                <Comment><![CDATA[MERGE MERGE1: 8 s blocked-release timeout for the main grant]]></Comment>,                <Text><![CDATA[XIC(MERGE_MERGE1_MAIN_GRANT)XIC(MERGE_MERGE1_MAIN_REQ)TON(MERGE_MERGE1_MAIN_TMR,?,?);]]></Text>,              </Rung>,              <Rung Number="8" Type="N">,                <Comment><![CDATA[MERGE MERGE1: 8 s blocked-release timeout for the spur grant]]></Comment>,                <Text><![CDATA[XIC(MERGE_MERGE1_SPUR_GRANT)XIC(MERGE_MERGE1_SPUR_REQ)TON(MERGE_MERGE1_SPUR_TMR,?,?);]]></Text>,              </Rung>,              <Rung Number="9" Type="N">,                <Comment><![CDATA[MERGE MERGE1: main grant timed out (upstream sensor stayed blocked) - SWAP the grant to the spur]]></Comment>,                <Text><![CDATA[XIC(MERGE_MERGE1_MAIN_TMR.DN)[OTU(MERGE_MERGE1_MAIN_GRANT) ,OTL(MERGE_MERGE1_SPUR_GRANT) ,MOV(1,NETS[1].ZPA[7].INPUTS.8) ,MOV(0,NETS[1].ZPA[1].INPUTS.8) ,OTU(MERGE_MERGE1_LAST_MAIN) ,RES(MERGE_MERGE1_MAIN_TMR) ,RES(MERGE_MERGE1_SPUR_TMR) ]]]></Text>,              </Rung>,              <Rung Number="10" Type="N">,                <Comment><![CDATA[MERGE MERGE1: spur grant timed out (upstream sensor stayed blocked) - SWAP the grant to the main line]]></Comment>,                <Text><![CDATA[XIC(MERGE_MERGE1_SPUR_TMR.DN)[OTU(MERGE_MERGE1_SPUR_GRANT) ,OTL(MERGE_MERGE1_MAIN_GRANT) ,MOV(1,NETS[1].ZPA[1].INPUTS.8) ,MOV(0,NETS[1].ZPA[7].INPUTS.8) ,OTL(MERGE_MERGE1_LAST_MAIN) ,RES(MERGE_MERGE1_MAIN_TMR) ,RES(MERGE_MERGE1_SPUR_TMR) ]]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="PUSHER_PUSHER1" Type="RLL">,            <Description><![CDATA[Pusher / divert control for PUSHER1 (block XFER01, SEG3, offset 1.5 m) - ONE-WAY divert (extend/retract; no reverse divert). I/O bit map: inputs: RETRACTED_SW=0, EXTENDED_SW=1, TRAY_PRESENT=2, DOWNSTREAM_CLEAR=3; outputs: EXTEND_SOL=0, RETRACT_SOL=1, DIVERT_ENABLE=2. (authored in ST, converted to ladder).]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[PUSHER PUSHER1 (one-way divert, block XFER01): state 0 = idle, 1 = extending, 2 = extended, 3 = retracting
I/O: inputs: RETRACTED_SW=0, EXTENDED_SW=1, TRAY_PRESENT=2, DOWNSTREAM_CLEAR=3; outputs: EXTEND_SOL=0, RETRACT_SOL=1, DIVERT_ENABLE=2]]></Comment>,                <Text><![CDATA[EQU(XFER01_STATE,0)[MOV(0,PUSHER1_EXTEND_SOL) ,MOV(1,PUSHER1_RETRACT_SOL) ,MOV(1,PUSHER1_DIVERT_ENABLE) ];]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Text><![CDATA[EQU(XFER01_STATE,0)XIC(XFER_CMD_PUSHER1)XIC(PUSHER1_TRAY_PRESENT)XIC(PUSHER1_DOWNSTREAM_CLEAR)MOV(1,XFER01_STATE);]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Text><![CDATA[EQU(XFER01_STATE,1)[MOV(1,PUSHER1_EXTEND_SOL) ,MOV(0,PUSHER1_RETRACT_SOL) ];]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Text><![CDATA[EQU(XFER01_STATE,1)XIC(PUSHER1_EXTENDED_SW)MOV(2,XFER01_STATE);]]></Text>,              </Rung>,              <Rung Number="4" Type="N">,                <Text><![CDATA[EQU(XFER01_STATE,1)TON(XFER01_EXTEND_TMR,800,XFER01_EXTEND_TMR.ACC);]]></Text>,              </Rung>,              <Rung Number="5" Type="N">,                <Text><![CDATA[EQU(XFER01_STATE,1)XIC(XFER01_EXTEND_TMR.DN)[MOV(1,XFER01_FAULT) ,MOV(3,XFER01_STATE) ];]]></Text>,              </Rung>,              <Rung Number="6" Type="N">,                <Text><![CDATA[EQU(XFER01_STATE,2)MOV(1,PUSHER1_EXTEND_SOL);]]></Text>,              </Rung>,              <Rung Number="7" Type="N">,                <Text><![CDATA[EQU(XFER01_STATE,2)XIO(PUSHER1_TRAY_PRESENT)MOV(3,XFER01_STATE);]]></Text>,              </Rung>,              <Rung Number="8" Type="N">,                <Text><![CDATA[EQU(XFER01_STATE,3)[MOV(0,PUSHER1_EXTEND_SOL) ,MOV(1,PUSHER1_RETRACT_SOL) ];]]></Text>,              </Rung>,              <Rung Number="9" Type="N">,                <Text><![CDATA[EQU(XFER01_STATE,3)XIC(PUSHER1_RETRACTED_SW)[MOV(0,XFER01_STATE) ,MOV(0,XFER01_FAULT) ];]]></Text>,              </Rung>,              <Rung Number="10" Type="N">,                <Text><![CDATA[EQU(XFER01_STATE,3)TON(XFER01_RETRACT_TMR,800,XFER01_RETRACT_TMR.ACC);]]></Text>,              </Rung>,              <Rung Number="11" Type="N">,                <Text><![CDATA[EQU(XFER01_STATE,3)XIC(XFER01_RETRACT_TMR.DN)[MOV(1,XFER01_FAULT) ,MOV(0,XFER01_STATE) ];]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="ROTARY_ROTARY1" Type="RLL">,            <Description><![CDATA[Rotary table control for ROTARY1 (block XFER02, SEG3, offset 2.5 m) - BIDIRECTIONAL router (shortest-path CW/CCW rotation; positions from 90 deg step). I/O bit map: inputs: HOME_SW=0, POS_90_SW=1, POS_180_SW=2, POS_270_SW=3, TRAY_PRESENT=4, INFEED_CLEAR=5; outputs: ROTATE_CW=0, ROTATE_CCW=1, TABLE_ENABLE=2, TABLE_BRAKE=3. (authored in ST, converted to ladder).]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[ROTARY TABLE ROTARY1 (bidirectional router, block XFER02): 4 positions of 90 deg
I/O: inputs: HOME_SW=0, POS_90_SW=1, POS_180_SW=2, POS_270_SW=3, TRAY_PRESENT=4, INFEED_CLEAR=5; outputs: ROTATE_CW=0, ROTATE_CCW=1, TABLE_ENABLE=2, TABLE_BRAKE=3
XFER_POS_ROTARY1 = current position status (0..3); XFER_DEST_ROTARY1 = requested destination (writable by route logic/HMI)]]></Comment>,                <Text><![CDATA[XIC(ROTARY1_HOME_SW)MOV(0,XFER_POS_ROTARY1);]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Text><![CDATA[XIC(ROTARY1_POS_90_SW)XIO(ROTARY1_HOME_SW)MOV(1,XFER_POS_ROTARY1);]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Text><![CDATA[XIC(ROTARY1_POS_180_SW)XIO(ROTARY1_HOME_SW)XIO(ROTARY1_POS_90_SW)MOV(2,XFER_POS_ROTARY1);]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Text><![CDATA[XIC(ROTARY1_POS_270_SW)XIO(ROTARY1_HOME_SW)XIO(ROTARY1_POS_90_SW)XIO(ROTARY1_POS_180_SW)MOV(3,XFER_POS_ROTARY1);]]></Text>,              </Rung>,              <Rung Number="4" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,0)[MOV(0,ROTARY1_ROTATE_CW) ,MOV(0,ROTARY1_ROTATE_CCW) ,MOV(0,ROTARY1_TABLE_BRAKE) ,MOV(1,ROTARY1_TABLE_ENABLE) ];]]></Text>,              </Rung>,              <Rung Number="5" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,0)XIC(XFER_CMD_ROTARY1)XIC(ROTARY1_TRAY_PRESENT)EQU(XFER_DEST_ROTARY1,XFER_POS_ROTARY1)CPT(XFER_DEST_ROTARY1,(XFER_POS_ROTARY1 + 1) MOD 4);]]></Text>,              </Rung>,              <Rung Number="6" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,0)XIC(XFER_CMD_ROTARY1)XIC(ROTARY1_TRAY_PRESENT)CPT(XFER02_DIFF,(XFER_DEST_ROTARY1 - XFER_POS_ROTARY1 + 4) MOD 4);]]></Text>,              </Rung>,              <Rung Number="7" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,0)XIC(XFER_CMD_ROTARY1)XIC(ROTARY1_TRAY_PRESENT)LEQ(XFER02_DIFF,2)MOV(1,XFER02_DIR);]]></Text>,              </Rung>,              <Rung Number="8" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,0)XIC(XFER_CMD_ROTARY1)XIC(ROTARY1_TRAY_PRESENT)GRT(XFER02_DIFF,2)MOV(0,XFER02_DIR);]]></Text>,              </Rung>,              <Rung Number="9" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,0)XIC(XFER_CMD_ROTARY1)XIC(ROTARY1_TRAY_PRESENT)MOV(1,XFER02_STATE);]]></Text>,              </Rung>,              <Rung Number="10" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,1)MOV(1,ROTARY1_TABLE_BRAKE);]]></Text>,              </Rung>,              <Rung Number="11" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,1)EQU(XFER02_DIR,1)[MOV(1,ROTARY1_ROTATE_CW) ,MOV(0,ROTARY1_ROTATE_CCW) ];]]></Text>,              </Rung>,              <Rung Number="12" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,1)NEQ(XFER02_DIR,1)[MOV(0,ROTARY1_ROTATE_CW) ,MOV(1,ROTARY1_ROTATE_CCW) ];]]></Text>,              </Rung>,              <Rung Number="13" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,1)EQU(XFER_POS_ROTARY1,XFER_DEST_ROTARY1)MOV(2,XFER02_STATE);]]></Text>,              </Rung>,              <Rung Number="14" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,1)TON(XFER02_ROTATE_TMR,3000,XFER02_ROTATE_TMR.ACC);]]></Text>,              </Rung>,              <Rung Number="15" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,1)XIC(XFER02_ROTATE_TMR.DN)[MOV(1,XFER02_FAULT) ,MOV(3,XFER02_STATE) ];]]></Text>,              </Rung>,              <Rung Number="16" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,2)[MOV(0,ROTARY1_ROTATE_CW) ,MOV(0,ROTARY1_ROTATE_CCW) ,MOV(0,ROTARY1_TABLE_BRAKE) ];]]></Text>,              </Rung>,              <Rung Number="17" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,2)XIO(XFER_CMD_ROTARY1)MOV(0,XFER02_STATE);]]></Text>,              </Rung>,              <Rung Number="18" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,3)[MOV(0,ROTARY1_ROTATE_CW) ,MOV(0,ROTARY1_ROTATE_CCW) ,MOV(0,ROTARY1_TABLE_BRAKE) ];]]></Text>,              </Rung>,              <Rung Number="19" Type="N">,                <Text><![CDATA[EQU(XFER02_STATE,3)XIO(XFER_CMD_ROTARY1)[MOV(0,XFER02_FAULT) ,MOV(0,XFER02_STATE) ];]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="POPUP_POPUP1" Type="RLL">,            <Description><![CDATA[Cross-belt pop-up transfer control for POPUP1 (block XFER03, SEG1, offset 3 m) - BIDIRECTIONAL cross transfer (left/right, interlocks LEFT_CLEAR/RIGHT_CLEAR). I/O bit map: inputs: POPUP_UP_SW=0, POPUP_DOWN_SW=1, TRAY_PRESENT=2, LEFT_CLEAR=3, RIGHT_CLEAR=4; outputs: RAISE=0, LOWER=1, BELT_LEFT=2, BELT_RIGHT=3, XFER_ENABLE=4. (authored in ST, converted to ladder).]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[POPUP TRANSFER POPUP1 (bidirectional cross transfer, block XFER03): state 0 = idle, 1 = raising, 2 = transferring, 3 = lowering, 4 = fault
I/O: inputs: POPUP_UP_SW=0, POPUP_DOWN_SW=1, TRAY_PRESENT=2, LEFT_CLEAR=3, RIGHT_CLEAR=4; outputs: RAISE=0, LOWER=1, BELT_LEFT=2, BELT_RIGHT=3, XFER_ENABLE=4]]></Comment>,                <Text><![CDATA[EQU(XFER03_STATE,0)[MOV(0,POPUP1_RAISE) ,MOV(1,POPUP1_LOWER) ,MOV(0,POPUP1_BELT_LEFT) ,MOV(0,POPUP1_BELT_RIGHT) ,MOV(1,POPUP1_XFER_ENABLE) ];]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,0)XIC(POPUP1_TRAY_PRESENT)XIC(POPUP1_POPUP_DOWN_SW)XIC(XFER_CMD_POPUP1_LEFT)XIC(POPUP1_LEFT_CLEAR)[MOV(1,XFER03_DIR) ,MOV(1,XFER03_STATE) ];]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,0)XIC(POPUP1_TRAY_PRESENT)XIC(POPUP1_POPUP_DOWN_SW)XIC(XFER_CMD_POPUP1_RIGHT)XIC(POPUP1_RIGHT_CLEAR)[MOV(2,XFER03_DIR) ,MOV(1,XFER03_STATE) ];]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,1)[MOV(1,POPUP1_RAISE) ,MOV(0,POPUP1_LOWER) ];]]></Text>,              </Rung>,              <Rung Number="4" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,1)XIC(POPUP1_POPUP_UP_SW)MOV(2,XFER03_STATE);]]></Text>,              </Rung>,              <Rung Number="5" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,1)TON(XFER03_RAISE_TMR,500,XFER03_RAISE_TMR.ACC);]]></Text>,              </Rung>,              <Rung Number="6" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,1)XIC(XFER03_RAISE_TMR.DN)[MOV(1,XFER03_FAULT) ,MOV(4,XFER03_STATE) ];]]></Text>,              </Rung>,              <Rung Number="7" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,2)[MOV(0,POPUP1_RAISE) ,MOV(0,POPUP1_LOWER) ];]]></Text>,              </Rung>,              <Rung Number="8" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,2)EQU(XFER03_DIR,1)[MOV(1,POPUP1_BELT_LEFT) ,MOV(0,POPUP1_BELT_RIGHT) ];]]></Text>,              </Rung>,              <Rung Number="9" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,2)EQU(XFER03_DIR,2)[MOV(0,POPUP1_BELT_LEFT) ,MOV(1,POPUP1_BELT_RIGHT) ];]]></Text>,              </Rung>,              <Rung Number="10" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,2)XIO(POPUP1_TRAY_PRESENT)MOV(3,XFER03_STATE);]]></Text>,              </Rung>,              <Rung Number="11" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,2)TON(XFER03_XFER_TMR,8000,XFER03_XFER_TMR.ACC);]]></Text>,              </Rung>,              <Rung Number="12" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,2)XIC(XFER03_XFER_TMR.DN)[MOV(1,XFER03_FAULT) ,MOV(4,XFER03_STATE) ];]]></Text>,              </Rung>,              <Rung Number="13" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,3)[MOV(0,POPUP1_RAISE) ,MOV(1,POPUP1_LOWER) ,MOV(0,POPUP1_BELT_LEFT) ,MOV(0,POPUP1_BELT_RIGHT) ];]]></Text>,              </Rung>,              <Rung Number="14" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,3)XIC(POPUP1_POPUP_DOWN_SW)MOV(0,XFER03_STATE);]]></Text>,              </Rung>,              <Rung Number="15" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,3)TON(XFER03_LOWER_TMR,500,XFER03_LOWER_TMR.ACC);]]></Text>,              </Rung>,              <Rung Number="16" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,3)XIC(XFER03_LOWER_TMR.DN)[MOV(1,XFER03_FAULT) ,MOV(4,XFER03_STATE) ];]]></Text>,              </Rung>,              <Rung Number="17" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,4)[MOV(0,POPUP1_RAISE) ,MOV(1,POPUP1_LOWER) ,MOV(0,POPUP1_BELT_LEFT) ,MOV(0,POPUP1_BELT_RIGHT) ];]]></Text>,              </Rung>,              <Rung Number="18" Type="N">,                <Text><![CDATA[EQU(XFER03_STATE,4)XIO(XFER_CMD_POPUP1_LEFT)XIO(XFER_CMD_POPUP1_RIGHT)[MOV(0,XFER03_FAULT) ,MOV(0,XFER03_STATE) ];]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="TRACK_INIT" Type="RLL">,            <Description><![CDATA[Tray tracking table initialisation (first scan): clears TRACK_TBL and the zone edge memory. (authored in ST, converted to ladder).]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[One-shot tray tracking initialisation (TRACK_INIT_DONE = 0 at download)]]></Comment>,                <Text><![CDATA[XIO(TRACK_INIT_DONE)MOV(0,TRACK_COUNT);]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Text><![CDATA[XIO(TRACK_INIT_DONE)FOR(L0,TRACK_NDX,0,15,1);]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Text><![CDATA[XIO(TRACK_INIT_DONE)[MOV(0,TRACK_TBL[TRACK_NDX].Valid) ,MOV(0,TRACK_TBL[TRACK_NDX].Zone) ,MOV(0,TRACK_TBL[TRACK_NDX].Seq) ,MOV(0,TRACK_TBL[TRACK_NDX].Timestamp) ];]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Text><![CDATA[NXT(L0);]]></Text>,              </Rung>,              <Rung Number="4" Type="N">,                <Text><![CDATA[XIO(TRACK_INIT_DONE)FOR(L1,TRACK_NDX,0,33,1);]]></Text>,              </Rung>,              <Rung Number="5" Type="N">,                <Text><![CDATA[XIO(TRACK_INIT_DONE)MOV(0,TRACK_SENS_PREV[TRACK_NDX]);]]></Text>,              </Rung>,              <Rung Number="6" Type="N">,                <Text><![CDATA[NXT(L1);]]></Text>,              </Rung>,              <Rung Number="7" Type="N">,                <Text><![CDATA[XIO(TRACK_INIT_DONE)MOV(1,TRACK_INIT_DONE);]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="TRACK_SCAN" Type="RLL">,            <Description><![CDATA[Tray tracking barcode scan: on GOOD_READ copies the scanner barcode into the next TRACK_TBL ring slot with its zone and sequence. (authored in ST, converted to ladder).]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[Scan zone SCAN1: barcode read into TRACK_TBL slot (TRACK_COUNT MOD 16)]]></Comment>,                <Text><![CDATA[XIC(SCAN1_GOOD_READ)XIO(SCAN1_SEEN)[MOD(TRACK_COUNT,16,TRACK_NDX) ,COP(SCAN1_BARCODE,TRACK_TBL[TRACK_NDX].Barcode,1) ,MOV(3,TRACK_TBL[TRACK_NDX].Zone) ,MOV(TRACK_COUNT,TRACK_TBL[TRACK_NDX].Seq) ,MOV(0,TRACK_TBL[TRACK_NDX].Timestamp) ,MOV(1,TRACK_TBL[TRACK_NDX].Valid) ,ADD(TRACK_COUNT,1,TRACK_COUNT) ,MOV(1,SCAN1_SEEN) ];]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Text><![CDATA[XIO(SCAN1_GOOD_READ)MOV(0,SCAN1_SEEN);]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Comment><![CDATA[The <SCAN>_BARCODE / <SCAN>_GOOD_READ tags are populated by the external
scanner (MSG/CIP) interface - see generator warnings for spare I/O bit mapping.]]></Comment>,                <Text><![CDATA[NOP();]]></Text>,              </Rung>,            </RLLContent>,          </Routine>,          <Routine Name="TRACK_MOVE" Type="RLL">,            <Description><![CDATA[Tray tracking move: on each zone sensor falling edge advances the tray to the next zone (clears it after the last zone). (authored in ST, converted to ladder).]]></Description>,            <RLLContent>,              <Rung Number="0" Type="N">,                <Comment><![CDATA[SEG1 zone 1: sensor falling edge -> tray leaves zone 1]]></Comment>,                <Text><![CDATA[XIO(NETS[1].ZPA[1].INPUTS.0)XIC(TRACK_SENS_PREV[0])MOV(1,TRACK_MOVE_ZONE);]]></Text>,              </Rung>,              <Rung Number="1" Type="N">,                <Text><![CDATA[XIC(NETS[1].ZPA[1].INPUTS.0)OTE(TRACK_SENS_PREV[0]);]]></Text>,              </Rung>,              <Rung Number="2" Type="N">,                <Comment><![CDATA[SEG1 zone 2: sensor falling edge -> tray leaves zone 2]]></Comment>,                <Text><![CDATA[XIO(NETS[1].ZPA[1].INPUTS.1)XIC(TRACK_SENS_PREV[1])MOV(2,TRACK_MOVE_ZONE);]]></Text>,              </Rung>,              <Rung Number="3" Type="N">,                <Text><![CDATA[XIC(NETS[1].ZPA[1].INPUTS.1)OTE(TRACK_SENS_PREV[1]);]]></Text>,              </Rung>,              <Rung Number="4" Type="N">,                <Comment><![CDATA[SEG1 zone 3: sensor falling edge -> tray leaves zone 3]]></Comment>,                <Text><![CDATA[XIO(NETS[1].ZPA[1].INPUTS.2)XIC(TRACK_SENS_PREV[2])MOV(3,TRACK_MOVE_ZONE);]]></Text>,              </Rung>,              <Rung Number="5" Type="N">,                <Text><![CDATA[XIC(NETS[1].ZPA[1].INPUTS.2)OTE(TRACK_SENS_PREV[2]);]]></Text>,              </Rung>,              <Rung Number="6" Type="N">,                <Comment><![CDATA[SEG1 zone 4: sensor falling edge -> tray leaves zone 4]]></Comment>,                <Text><![CDATA[XIO(NETS[1].ZPA[1